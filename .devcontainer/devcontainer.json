{
  "name": "${localWorkspaceFolderBasename}",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "mounts": [
    "source=${localWorkspaceFolderBasename}-claude-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "remoteEnv": {
    "PATH": "/opt/mise/shims:${containerEnv:PATH}"
  },
  "postCreateCommand": "make setup",
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "rust-lang.rust-analyzer", "timonwong.shellcheck", "mkhl.shfmt"],
      "settings": { "editor.formatOnSave": true }
    }
  }
}
