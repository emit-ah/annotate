{
  "name": "@emit-ah/annotate",
  "version": "0.1.0",
  "description": "An annotation mode for any web app: one script tag, hooks over plain JSON (ADR-0001)",
  "license": "SEE LICENSE IN ../LICENSE",
  "private": true,
  "type": "module",
  "main": "./dist/annotate.mjs",
  "module": "./dist/annotate.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/annotate.mjs"
    },
    "./annotate.js": "./dist/annotate.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "fmt": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "fake-indexeddb": "6.0.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "2.1.9"
  },
  "packageManager": "pnpm@9.15.0"
}
